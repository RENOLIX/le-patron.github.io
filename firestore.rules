rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function admin() { return signedIn() && profile().role == 'admin'; }
    function employee() { return signedIn() && profile().role == 'employee'; }

    match /products/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /shipping/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /orders/{id} {
      allow create: if true;
      allow read, delete: if admin();
      allow update: if admin() || (employee() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
    }
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if admin();
    }
    // Bootstrap du premier administrateur, limité à l'adresse définie.
    // Après sa création, seuls les administrateurs peuvent gérer les profils.
    function initialAdmin(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email == 'admin@lepatronfacile.dz'
        && request.resource.data.email == 'admin@lepatronfacile.dz'
        && request.resource.data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin() || initialAdmin(uid);
      allow update, delete: if admin();
    }
  }
}
